{
  "name": "zupu",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply zupu --local",
    "db:migrate:remote": "wrangler d1 migrations apply zupu --remote",
    "seed": "tsx scripts/seed.ts",
    "backup": "mkdir -p backups && wrangler d1 export zupu --remote --output backups/family-$(date +%F).sql",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "d3": "^7.9.0",
    "family-chart": "0.9.0",
    "libphonenumber-js": "^1.13.16",
    "lucide": "^1.74.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.163.0"
  },
  "private": true
}
